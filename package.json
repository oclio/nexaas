{
  "name": "nexaas",
  "version": "0.0.0",
  "private": true,
  "description": "A scalable, production-ready SaaS boilerplate built for high performance and rapid prototyping in Next.js.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "check:types": "tsc --noEmit",
    "check:fast": "pnpm check:types && pnpm lint:fix && pnpm knip && true",
    "check:all": "pnpm check:fast && pnpm check:secrets && pnpm build && true",
    "check:secrets": "gitleaks protect --staged --verbose",
    "knip": "knip --config knip.config.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unicorn": "^73.0.0",
    "gitleaks": "^1.0.0",
    "knip": "^6.32.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
