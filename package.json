{
  "name": "nexaas",
  "version": "0.2.0",
  "description": "A scalable, production-ready SaaS boilerplate built for high performance and rapid prototyping in Next.js.",
  "keywords": [
    "nextjs",
    "nextjs-boilerplate",
    "saas",
    "saas-boilerplate",
    "starter",
    "template",
    "typescript",
    "react",
    "tailwindcss",
    "production-ready"
  ],
  "license": "MIT",
  "author": {
    "name": "oclio",
    "email": "hello@oclio.dev",
    "url": "https://oclio.dev"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest run --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:ui": "pnpm exec playwright test --ui",
    "test:e2e:report": "pnpm exec playwright show-report",
    "test:mutate": "stryker run",
    "test:mutate:only": "pnpm exec stryker run --mutate",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "check:types": "tsc --noEmit",
    "check:fast": "pnpm check:types && pnpm lint:fix && pnpm knip && true",
    "check:all": "pnpm check:fast && pnpm check:secrets && pnpm check:md && pnpm check:spell && pnpm build && true",
    "check:secrets": "gitleaks protect --staged --verbose",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:md": "markdownlint '**/*.md' --fix --ignore **/node_modules/** --ignore **/.next/**",
    "check:spell": "cspell '**/*.{ts,md,json,yml,yaml}' --no-progress --gitignore",
    "knip": "knip --config knip.config.mjs",
    "prepare": "husky",
    "commit": "cz",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.13.11",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.13.0",
    "@changesets/cli": "^3.0.1",
    "@commitlint/config-conventional": "^21.2.2",
    "@next/bundle-analyzer": "^16.3.3",
    "@playwright/test": "^1.55.0",
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "commitizen": "^4.3.2",
    "commitlint": "^21.2.2",
    "cross-env": "^10.1.0",
    "cspell": "^10.1.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unicorn": "^73.0.0",
    "gitleaks": "^1.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.32.3",
    "lint-staged": "^17.4.1",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.md": [
      "markdownlint --fix --ignore CHANGELOG.md"
    ],
    "*.{ts,tsx,json,md,yml,yaml}": [
      "prettier --write",
      "cspell --no-must-find-files"
    ]
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
