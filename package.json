{
  "name": "nexaas",
  "version": "0.0.0",
  "private": true,
  "description": "A scalable, production-ready SaaS boilerplate built for high performance and rapid prototyping in Next.js.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "check:types": "tsc --noEmit",
    "check:fast": "pnpm check:types && pnpm lint:fix && true",
    "check:all": "pnpm check:fast && pnpm build && true"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
